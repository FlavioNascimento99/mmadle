# Copy to .env and adjust for local development.
# Never commit real secrets.

# PostgreSQL (used by docker compose + backend)
POSTGRES_USER=mmadle
POSTGRES_PASSWORD=mmadle_dev_password
POSTGRES_DB=mmadle
DATABASE_URL=postgres://mmadle:mmadle_dev_password@localhost:5432/mmadle?sslmode=disable

# Backend
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
GAME_TIMEZONE=UTC
# Session cookie lifetime (Go duration string). The cookie is
# HttpOnly + SameSite=Lax; Secure is on unless SESSION_COOKIE_SECURE=false
# (needed for plain-http local development only).
SESSION_TTL=720h
SESSION_COOKIE_SECURE=false

# Frontend (browser-visible; must start with NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:8080
