# Copy to .env and adjust for local development.
# Never commit real secrets.

# PostgreSQL (used by docker compose + backend)
POSTGRES_USER=mmadle
POSTGRES_PASSWORD=mmadle_dev_password
POSTGRES_DB=mmadle
DATABASE_URL=postgres://mmadle:mmadle_dev_password@localhost:5432/mmadle?sslmode=disable

# Backend
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
GAME_TIMEZONE=UTC
# Session cookie lifetime (Go duration string). The cookie is
# HttpOnly + SameSite=Lax; Secure is on unless SESSION_COOKIE_SECURE=false
# (needed for plain-http local development only).
SESSION_TTL=720h
SESSION_COOKIE_SECURE=false
# Admin allowlist (comma-separated usernames). Matching accounts promote to
# the admin role on register/login and unlock /admin + /api/admin/*. Removing
# a name here does not demote (UPDATE users SET role='player' ...).
ADMIN_USERNAMES=
# Cloudflare analytics proxy for the admin Worker-infra panel. Prefer
# `npx wrangler secret put CLOUDFLARE_API_TOKEN` (needs Analytics:Read) and
# CLOUDFLARE_ACCOUNT_ID on deploy; plain env works for local development.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Frontend (browser-visible; must start with NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:8080
